# Copy this file to .env and paste your free API keys after the = sign.
# No spaces, no quotes. The .env file is ignored by git, so keys never reach GitHub.

# https://www.virustotal.com  -> profile icon -> API Key
VT_API_KEY=

# https://www.abuseipdb.com  -> User Account -> API -> Create Key
ABUSEIPDB_API_KEY=

# https://otx.alienvault.com  -> username -> Settings -> OTX Key
OTX_API_KEY=

# https://auth.abuse.ch  -> log in -> Optional -> Auth-Key
# One key covers MalwareBazaar, URLhaus and ThreatFox
ABUSECH_API_KEY=

# Optional. GreyNoise works without a key (about 10 lookups a day).
# A free key needs a business email address.
GREYNOISE_API_KEY=
